// Bacterial isolate genome pipeline: fastp -> SPAdes -> QUAST / CheckM2 / Bakta / GTDB-Tk
//
// Pick one software profile and, on a cluster, an executor profile:
//   -profile docker | singularity | apptainer | conda      (+ slurm)
// The three reference databases have to be given (or set in your own -c config).

manifest {
    name            = 'bbr_genomes'
    description     = 'Assembly, QC, annotation and taxonomy of bacterial isolate genomes (Illumina PE)'
    author          = 'Rodrigo Taketani'
    mainScript      = 'main.nf'
    nextflowVersion = '>=25.10.0'
    version         = '1.0.0'
}

params {
    samplesheet         = null          // TSV: sample_name <tab> read1 <tab> read2 (.fastq.gz)
    outdir              = 'results'     // one folder per genome is created in here

    // Reference databases (required)
    bakta_db            = null          // Bakta DB folder (full or light), `bakta_db download`
    checkm2_db          = null          // CheckM2 uniref100.KO.1.dmnd, `checkm2 database --download`
    gtdbtk_db           = null          // GTDB-Tk release folder (GTDBTK_DATA_PATH), e.g. release232/

    // Tool options
    save_trimmed_reads  = true          // copy fastp-trimmed reads into each genome folder
    spades_mode         = '--isolate'
    min_contig_len      = 500           // contigs shorter than this are dropped after SPAdes
    gtdbtk_batch_size   = 100           // genomes per GTDB-Tk job (batches run in parallel)
    gtdbtk_pplacer_cpus = 8             // pplacer memory grows with its thread count
    gtdbtk_full_tree    = false         // true needs ~1.5 TB RAM

    // Slurm (used by -profile slurm)
    slurm_partition     = null          // null = cluster default partition
    largemem_partition  = null          // used for GTDB-Tk when gtdbtk_full_tree = true
    queue_size          = 20            // max jobs in Slurm at once (pending + running)
    submit_rate         = '10/1min'
}

includeConfig 'conf/base.config'

profiles {
    // ---- software
    docker {
        docker.enabled  = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        includeConfig 'conf/containers.config'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        includeConfig 'conf/containers.config'
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        includeConfig 'conf/containers.config'
    }
    conda {
        conda.enabled = true
        includeConfig 'conf/conda.config'
    }

    // ---- executors
    standard {
        process.executor = 'local'
    }
    slurm {
        process.executor = 'slurm'
        process.queue    = { task.process == 'GTDBTK' && params.gtdbtk_full_tree && params.largemem_partition ? params.largemem_partition : params.slurm_partition }
        executor {
            queueSize       = params.queue_size
            submitRateLimit = params.submit_rate
            pollInterval    = '1 min'
        }
    }

    // ---- small simulated dataset in test/ (3 genomes); combine with a software profile
    test {
        params.samplesheet       = "${projectDir}/test/samplesheet_test.tsv"
        params.outdir            = 'test_results'
        params.gtdbtk_batch_size = 2
    }
}

// Read by bin/pipeline_progress.sh to count failed genomes per step
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
    fields    = 'task_id,hash,native_id,process,tag,status,exit,attempt,duration,realtime,%cpu,peak_rss,workdir'
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/report.html"
}
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
}
