// Resources and failure handling, shared by every profile.
// On a machine smaller than these requests, cap them, e.g. in a -c my.config:
//   process.resourceLimits = [cpus: 16, memory: 128.GB, time: 48.h]

process {
    // Retry when killed for memory/time (resources scale with task.attempt), otherwise
    // skip that genome and keep the rest running -- failures show up in progress.txt
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143, 247] && task.attempt <= 2 ? 'retry' : 'ignore' }
    maxRetries    = 2

    cpus   = 2
    memory = 4.GB
    time   = 2.h

    withName: 'FASTP' {
        cpus   = 8
        memory = { 16.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
    // 15 cpus so two assemblies fit on one 31-cpu node
    withName: 'SPADES' {
        cpus   = 15
        memory = { 64.GB * task.attempt }
        time   = { 24.h * task.attempt }
    }
    withName: 'QUAST' {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
    withName: 'CHECKM2' {
        cpus   = 8
        memory = { 32.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withName: 'BAKTA' {
        cpus   = 8
        memory = { 32.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
    withName: 'GTDBTK' {
        cpus   = 31
        memory = { params.gtdbtk_full_tree ? 1400.GB : 160.GB * task.attempt }
        time   = { 48.h * task.attempt }
    }
}
