// Bioconda packages (conda profile). Same versions as conf/containers.config.

process {
    withName: 'FASTP'   { conda = 'bioconda::fastp=1.4.0' }
    withName: 'SPADES'  { conda = 'bioconda::spades=4.0.0' }
    withName: 'QUAST'   { conda = 'bioconda::quast=5.2.0' }
    withName: 'CHECKM2' { conda = 'bioconda::checkm2=1.1.0' }
    withName: 'BAKTA'   { conda = 'bioconda::bakta=1.12.2' }
    withName: 'GTDBTK'  { conda = 'bioconda::gtdbtk=2.8.0' }
}
