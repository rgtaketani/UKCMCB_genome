// BioContainers images (docker / singularity / apptainer profiles).
// Same tool versions as the conda profile.

process {
    withName: 'FASTP'   { container = 'quay.io/biocontainers/fastp:1.4.0--h43da1c4_0' }
    withName: 'SPADES'  { container = 'quay.io/biocontainers/spades:4.0.0--h5fb382e_1' }
    withName: 'QUAST'   { container = 'quay.io/biocontainers/quast:5.2.0--py39pl5321h2add14b_1' }
    withName: 'CHECKM2' { container = 'quay.io/biocontainers/checkm2:1.1.0--pyhdfd78af_2' }
    withName: 'BAKTA'   { container = 'quay.io/biocontainers/bakta:1.12.2--pyhdfd78af_0' }
    withName: 'GTDBTK'  { container = 'quay.io/biocontainers/gtdbtk:2.8.0--pyhdfd78af_0' }
}
